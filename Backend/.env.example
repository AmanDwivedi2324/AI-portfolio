# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/portfolio
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Optional: database name inside the cluster (production uses "portfolio_v2")
MONGO_DB_NAME=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every admin out.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: image/PDF uploads go to Cloudinary when all three are set,
# otherwise to public/uploads (fine locally, wiped on Render redeploys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
