# Copy to .env and fill in. Never commit .env.

ENV=development

# ── LLM: Groq (https://console.groq.com/keys) ──
GROQ_API_KEY=
# gpt-oss-120b ≈ 500 tok/s; openai/gpt-oss-20b ≈ 1000 tok/s if you want even faster replies
GROQ_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# ── Vector store ──
# auto = Pinecone when PINECONE_API_KEY is set, otherwise the local index
VECTOR_STORE=auto
PINECONE_API_KEY=
PINECONE_INDEX=aman-portfolio-kb
PINECONE_NAMESPACE=kb-v2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Retrieval tuning (re-check with: python -m scripts.eval_retrieval) ──
RELEVANCE_THRESHOLD=0.48
TOP_K=6

# ── API ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300
# true behind Render/Vercel/NGINX so rate limits use the real client IP
TRUST_PROXY=false

# ── Knowledge-base updates ──
# Secret that protects POST /admin/reload (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=
# `python -m app.ingest` pings this after uploading, so the running service reloads without a restart
CHATBOT_RELOAD_URL=http://127.0.0.1:8000/admin/reload
# memory = load vectors from Pinecone at startup and search in RAM (fast); remote = query Pinecone per question
PINECONE_QUERY_MODE=memory
